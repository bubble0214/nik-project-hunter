# =============================================================================
# Nik Project Hunter — 环境变量模板
# =============================================================================
# 复制此文件为 .env 并填写你的配置
# cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=nik_project_hunter
POSTGRES_USER=nik
POSTGRES_PASSWORD=nik_secret_2026
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- pgAdmin ---
PGADMIN_EMAIL=nik@hoyin.com
PGADMIN_PASSWORD=admin_2026
PGADMIN_PORT=5050

# --- LLM API（必填）---
# 默认使用 DeepSeek，可改为 OpenAI / Claude
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- 应用配置 ---
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs                    # 日志文件目录
CRAWL_INTERVAL_MINUTES=60       # 定时爬取间隔（分钟）
# CRAWL_CRON_EXPR=0 */6 * * *   # 可选：cron 表达式（优先级高于间隔）

# --- 通知 Webhook（企业微信机器人）---
# 格式：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
WECHAT_WEBHOOK_URL=

# --- Docker Compose 项目名前缀 ---
COMPOSE_PROJECT_NAME=nik-project-hunter