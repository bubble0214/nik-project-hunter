# =============================================================================
# Nik Project Hunter — 环境变量模板
# =============================================================================
# 复制此文件为 .env 并填写你的配置
# cp .env.example .env
# =============================================================================

# --- PostgreSQL（必填）---
DATABASE_URL=postgresql+asyncpg://nik:your_secure_password@localhost:5432/nik_project_hunter
POSTGRES_DB=nik_project_hunter
POSTGRES_USER=nik
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- pgAdmin（仅开发环境，生产环境应移除）---
PGADMIN_EMAIL=nik@hoyin.com
PGADMIN_PASSWORD=your_secure_password
PGADMIN_PORT=5050

# --- LLM API（必填）---
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- API 认证（生产环境必填）---
# 留空则跳过认证（仅开发模式），生产环境必须设置
API_KEY=

# --- CORS（生产环境必填）---
# 逗号分隔的允许来源，留空则允许所有来源（仅开发模式）
# 示例：CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# --- 应用配置 ---
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs                    # 日志文件目录
CRAWL_INTERVAL_MINUTES=60       # 定时爬取间隔（分钟）
# CRAWL_CRON_EXPR=0 */6 * * *   # 可选：cron 表达式（优先级高于间隔）

# --- 通知 Webhook（企业微信机器人）---
# 格式：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
WECHAT_WEBHOOK_URL=

# --- Docker Compose 项目名前缀 ---
COMPOSE_PROJECT_NAME=nik-project-hunter